# ─────────────────────────────────────────────────────────────
#  大模型接入配置（可选）
#
#  用法：把本文件复制为 llm.env，填入你自己的值，然后重启服务。
#        llm.env 已在 .gitignore 中，不会被提交。
#
#  若某项在系统环境变量里已经存在，则以系统环境变量为准（本文件不覆盖它）。
#  服务启动时会打印「已从 ... 加载 N 项配置」，但不会回显任何取值。
# ─────────────────────────────────────────────────────────────

# 接口地址（不要写到 /chat/completions，程序会自动拼）
CALCULUS_LLM_BASE_URL=https://api.deepseek.com

# 你的密钥。只从环境变量/本文件读取，不会写进代码或数据库。
CALCULUS_LLM_API_KEY=sk-在这里填你的密钥

# 模型名。DeepSeek 当前为 deepseek-flash / deepseek-v4-pro
CALCULUS_LLM_MODEL=deepseek-flash


# ── 强烈建议设置：思考模式 ──────────────────────────────────
#
#  DeepSeek 的思考模式**默认开启**，但查手册类问答用它纯属浪费：
#  实测同一个问题，开启思考后输出 token 多花 3~4 倍、耗时从 2.2s 涨到 11.5s。
#
#   deep_think = 平时关闭，界面上「深度思考」开关打开时才启用  ← 推荐
#   off        = 始终关闭（最快最省）
#   on         = 始终开启
#   auto       = 不发送该参数，完全用服务商默认（DeepSeek 即等于 on）
CALCULUS_LLM_THINKING=deep_think


# ── 以下都是可选项，删掉即用默认值 ──────────────────────────

# 流式输出，默认 1。设为 0 则等模型一次性返回后再显示。
CALCULUS_LLM_STREAM=1

# 单次请求超时（秒），默认 60
CALCULUS_LLM_TIMEOUT=60

# 回答随机性，默认 0.2（越低越稳定；注意思考模式下该参数无效）
CALCULUS_LLM_TEMPERATURE=0.2

# 思考强度，仅在启用思考模式时发送。可选 low / high / max。
# 不设置则用服务商默认（DeepSeek 默认 high）。
# CALCULUS_LLM_REASONING_EFFORT=high

# ⚠️ 默认【不发送】max_tokens，这是故意的。
#    实测：思考模式下思考内容会先吃掉预算，max_tokens=64 时 64 个 token
#    全被思考消耗，**正文一个字都没有**。与其猜一个安全值，不如交给服务端默认上限。
#    确有限制需要时再取消注释，并给足够大的值（建议 ≥4096）。
# CALCULUS_LLM_MAX_TOKENS=4096


# ─────────────────────────────────────────────────────────────
#  常见服务商填法（把上面三行换成对应的一组即可）
#
#  DeepSeek（便宜、中文好，推荐）
#    BASE_URL=https://api.deepseek.com          ← 注意：没有 /v1
#    MODEL=deepseek-flash                       ← 或 deepseek-v4-pro
#    THINKING=deep_think
#
#  OpenAI
#    BASE_URL=https://api.openai.com/v1
#    MODEL=gpt-4o-mini
#    THINKING=auto
#
#  阿里云百炼 / 通义千问（OpenAI 兼容模式）
#    BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#    MODEL=qwen-plus
#    THINKING=auto
#
#  月之暗面 Kimi
#    BASE_URL=https://api.moonshot.cn/v1
#    MODEL=moonshot-v1-8k
#    THINKING=auto
#
#  智谱 GLM
#    BASE_URL=https://open.bigmodel.cn/api/paas/v4
#    MODEL=glm-4-flash
#    THINKING=auto
#
#  硅基流动
#    BASE_URL=https://api.siliconflow.cn/v1
#    MODEL=deepseek-ai/DeepSeek-V3
#    THINKING=auto
#
#  本地 Ollama（不联网、不花钱）
#    BASE_URL=http://127.0.0.1:11434/v1
#    API_KEY=ollama            # Ollama 不校验，但这里必须非空才会启用
#    MODEL=qwen2.5:7b
#    THINKING=auto
#
#  说明：THINKING 发送的是 {"thinking":{"type":"enabled|disabled"}}，
#  这是 DeepSeek 的参数。其他服务商不认这个字段，所以默认 auto（不发送）。
# ─────────────────────────────────────────────────────────────
